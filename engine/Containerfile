# DAV Engine container image
# Built at deploy time from repo root via Ansible role's engine.yaml task.
# The build context is the engine/ directory; the role copies it to a
# temporary build-dir on the provisioner and invokes oc start-build against
# an OpenShift BuildConfig using Docker strategy.

FROM python:3.11-slim

# Source provenance — populated by Ansible role at build time via --build-arg.
# Lets operators verify "running image == expected source" without having to
# grep marker code. Inspect via:
#   skopeo inspect docker://.../dav-engine:latest \
#     | jq -r '.Labels."org.opencontainers.image.revision"'
ARG DAV_REPO_COMMIT=unknown
ARG DAV_REPO_DIRTY=unknown
LABEL org.opencontainers.image.revision="${DAV_REPO_COMMIT}" \
      org.opencontainers.image.title="dav-engine" \
      io.dav.repo.dirty="${DAV_REPO_DIRTY}"

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /engine

# Install runtime deps separately for Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install the dav package in editable mode (src layout)
COPY pyproject.toml .
COPY src/ ./src/
RUN pip install --no-cache-dir -e .

# Bake the commit where version.py's upward walk finds it (/engine is an
# ancestor of src/dav/core/version.py). Two mechanisms, file wins:
#
# 1. COPY from the build context. The Ansible role writes the real SHA into
#    the context before oc start-build; the repo carries an "unknown"
#    placeholder so non-Ansible builds don't fail the COPY. This path cannot
#    be dropped by tooling.
# 2. The build-arg overwrite, kept for whenever it works — the deploy
#    assertion's FIRST live run revealed that `oc start-build --build-arg`
#    has been silently dropped for this BuildConfig since the labels were
#    added: build specs carry no buildArgs, so the OCI revision label has
#    read "unknown" the whole time and nobody could tell until something
#    asserted on it. The guard keeps a defaulted arg from clobbering the
#    real file.
COPY BUILD_COMMIT /engine/BUILD_COMMIT
RUN [ "${DAV_REPO_COMMIT}" != "unknown" ] && printf '%s' "${DAV_REPO_COMMIT}" > /engine/BUILD_COMMIT || true

# dav is importable as a package (and pip install -e also sets the
# right paths), but we also set PYTHONPATH explicitly for any scripts
# that expect bare module imports.
ENV PYTHONPATH=/engine/src
