---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dav-review-ui-nginx
  namespace: {{ dav_namespace }}
  labels:
    app: dav-review
    component: review-console-ui
data:
  # UBI nginx-124 bakes its own `server { listen 8080 default_server; ... }`
  # directly into /etc/nginx/nginx.conf and includes this directory from
  # inside that block. We contribute location{} directives only — no
  # surrounding server{} wrapper — and they merge into the image's server.
  review.conf: |
    # Security headers applied to all responses from this server.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Allow large assessment uploads (multi-MB PDFs / slide decks / images for vision ingest,
    # #113). nginx's 1m default 413s a real deck BEFORE it reaches the API (no server log,
    # just a bare error in the UI). Merges into the image's server block.
    client_max_body_size 64m;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

{% if review_console_relaxed_proxy | default(false) %}
    # Relaxed-proxy mode: /sso stays OCP-protected (oauth-proxy does NOT skip it)
    # and routes to the API's session-minting endpoint, which reads the
    # X-Forwarded headers and 303s back to /. OCP users hit this once to get an
    # app session; thereafter the (skip-auth) /api/* calls use the cookie.
    location = /sso {
        proxy_pass http://dav-review-api:8000/api/auth/sso;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-User $http_x_forwarded_user;
        proxy_set_header X-Forwarded-Email $http_x_forwarded_email;
        proxy_set_header X-Auth-Request-User $http_x_auth_request_user;
        proxy_set_header X-Auth-Request-Email $http_x_auth_request_email;
    }
{% endif %}
    location /api/ {
        proxy_pass http://dav-review-api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

{% if review_console_relaxed_proxy | default(false) %}
        # SECURITY (relaxed-proxy mode): oauth-proxy SKIPS /api/ (--skip-auth-regex
        # ^/api/), so any inbound X-Forwarded-*/X-Auth-Request-* identity header is
        # CLIENT-supplied and trivially spoofable (a full auth bypass to any
        # identity, incl. platform admin). Identity on /api/ comes ONLY from the
        # signed session cookie minted at the oauth-protected /sso endpoint —
        # clear these so the API can never trust a spoofed header here.
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Email "";
        proxy_set_header X-Auth-Request-User "";
        proxy_set_header X-Auth-Request-Email "";
{% else %}
        # Strict-proxy mode: oauth-proxy authenticates /api/ and sets these —
        # pass them through so the API can attribute actions to the OCP user.
        proxy_set_header X-Forwarded-User $http_x_forwarded_user;
        proxy_set_header X-Forwarded-Email $http_x_forwarded_email;
        proxy_set_header X-Auth-Request-User $http_x_auth_request_user;
        proxy_set_header X-Auth-Request-Email $http_x_auth_request_email;
{% endif %}

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        # M12 — LLM-backed endpoints (/api/uc-assist long generations,
        # /api/use-cases/bulk-from-text transcript extraction, the wizard's
        # refine flow against larger models) routinely exceed 60s. Match
        # the route's 600s ceiling so the wait propagates end-to-end:
        # client → route (600s) → nginx (600s) → API → LLM.
        proxy_read_timeout    600s;
    }

    # The whole SPA is one index.html that changes on every deploy, so the
    # browser must revalidate it — otherwise users keep serving a stale cached
    # copy and don't see new releases until a manual hard-refresh.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files /index.html =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
