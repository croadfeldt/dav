---
# Tekton Pipeline: full DAV stage 2 corpus run.
#
# The pipeline:
#
#   1. Clones the consumer's spec repo (architecture docs)
#   2. Clones the consumer's corpus repo (use cases + dav-version.yaml)
#   3. Runs dav-run-corpus across the entire corpus
#
# All three steps share one workspace, with the spec and corpus going
# into separate subdirectories. This keeps the pipeline simple (one
# workspace, no inter-step PVC juggling) while preserving the two-repo
# architecture for the consumer side.
#
# The pipeline finishes when run-corpus finishes — successfully if all
# UCs analyzed, failed if --halt-on-error fired on a UC failure or the
# runner itself crashed. Per-UC failures with continue-on-error are
# reported in the run summary, not as pipeline failures.

apiVersion: tekton.dev/v1
kind: Pipeline
metadata:
  name: dav-stage2
  namespace: {{ dav_namespace }}
  labels:
    app.kubernetes.io/part-of: dav
spec:
  description: |
    Run DAV stage 2 across the consumer's full UC corpus.

  params:
    # Consumer source repos (defaults from group_vars/all/vars.yaml)
    - name: consumer-spec-repo-url
      type: string
      default: "{{ consumer_spec_repo_url }}"
    - name: consumer-spec-repo-branch
      type: string
      default: "{{ consumer_spec_repo_branch }}"
    # Where to put the cloned content within the workspace
    - name: spec-subdir
      type: string
      default: "spec"
    - name: corpus-subdir
      type: string
      default: "corpus"

    # Path to the use-case directory inside the corpus repo (DCM
    # convention: use-cases/ at the corpus repo root). Used only in
    # legacy single-source corpus mode. Multi-source corpus mode
    # (ADR-007/M11) honors per-source root_path at clone time, so this
    # param is ignored when dav-source-corpus has a `sources` key.
    - name: corpus-uc-subpath
      type: string
      default: "use-cases"

    # Per-run corpus namespace filter (ADR-007 / M11b). Comma-separated
    # list of source namespaces to include for this run. Empty string
    # means "include all sources in the ConfigMap" — the common case
    # (full-corpus regression). Operators select a subset from the
    # New Run modal for ad-hoc / debug runs. Ignored in legacy
    # single-source corpus mode.
    - name: corpus-namespaces
      type: string
      default: ""

    # Per-run spec namespace filter (M12 follow-up). Comma-separated list
    # of role=spec source namespaces the engine should focus the LLM on
    # during MCP grounding. Empty = no narrowing (default). Soft enforcement:
    # the MCP itself still serves every spec namespace — this only injects
    # a focus hint into the run-corpus engine's LLM system prompt.
    - name: spec-namespaces
      type: string
      default: ""

    # Run-corpus settings
    - name: mode
      type: string
      default: "verification"
    - name: sample-count
      type: string
      default: ""
    - name: sample-concurrency
      type: string
      default: ""
    - name: uc-concurrency
      type: string
      default: ""
    - name: halt-on-error
      type: string
      default: "false"
    # UC filter — when set, run-corpus processes only matching UCs.
    # Empty = whole corpus subpath (legacy behavior).
    - name: uc-handles
      type: string
      default: ""
    - name: uc-uuids
      type: string
      default: ""
    # ADR-009 gap identity: project catalog capability ids for guided-JSON
    # enum-constraint of gaps[].capability_id. Empty = unconstrained.
    - name: known-capability-ids
      type: string
      default: ""
    # #93/#125: per-project Evaluation (stage-2) prompt context. The TASK has
    # declared + consumed this param since the F8 build, but the pipeline never
    # forwarded it — the trigger's value was silently dropped at this boundary
    # and every "context applied" run actually ran the baseline prompt
    # (discovered when the E2 battery's anchor moved nothing it targeted).
    - name: stage2-context
      type: string
      default: ""
    # E1 gap tagging: catalog names (b64 JSON) + enable flag for the
    # post-sample untagged-gap classifier.
    - name: capability-catalog-b64
      type: string
      default: ""
    - name: tag-untagged-gaps
      type: string
      default: ""
    # Managed-UC test eval: fetch UC YAML from the console API instead
    # of requiring the UC to be in the corpus repo. Used pre-promotion.
    - name: managed-uc-uuids
      type: string
      default: ""
    - name: console-api-url
      type: string
      default: ""

    # Inference + MCP
    - name: inference-endpoint
      type: string
      default: "{{ inference_primary_endpoint }}"
    - name: inference-model
      type: string
      default: "{{ inference_primary_model }}"
    # Optional per-stage routing: pass 1 (explore) on a fast model, pass 2
    # (verdict) on inference-model. Empty default is load-bearing — a pipeline
    # param default is not a fallback, it is a value that gets passed, so these
    # must stay empty for the Task's "unset = single model" branch to fire.
    - name: pass1-inference-endpoint
      type: string
      default: ""
    - name: pass1-inference-model
      type: string
      default: ""
    - name: inference-topology
      type: string
      default: "{{ inference_topology | default('') }}"
    - name: mcp-url
      type: string
      default: "http://dav-docs-mcp.{{ dav_namespace }}.svc:8080"

    # Optional consumer profile override
    - name: consumer-profile-path
      type: string
      default: ""

    # Per-(model, use) override system (DAV migration 014)
    - name: use-key
      type: string
      default: ""
    - name: capabilities-json
      type: string
      default: ""
    - name: use-profile-json
      type: string
      default: ""
    - name: stage2-two-pass
      type: string
      default: "1"
    - name: grounding-nudge
      type: string
      default: "0"
    # Per-run inference constraints. Empty = use the run-corpus task defaults
    # (max-tokens {{ dav_stage2_max_tokens | default(10240) }}, request timeout 900s).
    # The console (RunTriggerIn) sets these only when the caller overrides them;
    # the Pipeline MUST declare + forward them or Tekton rejects the PipelineRun
    # as carrying an undeclared param.
    - name: max-tokens
      type: string
      default: ""
    # Defaults to the site value, NOT "" — the Pipeline forwards its own default to
    # the task, so an empty default here silently SHADOWS the task's
    # dav_stage2_request_timeout_seconds and every run falls back to the engine's
    # 900s regardless of what the task says. Keep the two in step.
    - name: request-timeout-seconds
      type: string
      default: "{{ dav_stage2_request_timeout_seconds }}"

  workspaces:
    - name: shared-data
      description: |
        Shared workspace. Two upstream sync tasks populate <spec-subdir>
        and <corpus-subdir>; the run-corpus task reads from both and
        writes results to results/<run-id>/.

  tasks:
    # 1. Per-run source isolation + clean slate before sync (task #52).
    #    Concurrent PipelineRuns (e.g. an A/B experiment's two arms) share
    #    the dav-workspace PVC, so a single shared spec/ + corpus/ pair made
    #    them race at sync — one arm rm -rf'd or cloned over the other's tree
    #    (FileExistsError on corpus/<ns>/...). Each run now clones its source
    #    under <pipelineRun-name>/{spec,corpus}; the run name is unique, so
    #    the arms never touch the same files. This task wipes THIS run's own
    #    source root for a clean fresh-clone (covers a same-name retry); the
    #    finally block GCs it after run-corpus.
    #
    #    NOT touched: results/ — it lives at the workspace top level keyed by
    #    run-id (shared, read by the review console), never per-run.
    - name: cleanup-workspace
      timeout: "5m"
      params:
        - name: run-dir
          value: $(context.pipelineRun.name)
      taskSpec:
        params:
          - name: run-dir
            type: string
        workspaces:
          - name: source
        steps:
          - name: wipe-run-source
            image: registry.access.redhat.com/ubi9/ubi-minimal
            script: |
              #!/bin/sh
              set -e
              cd "$(workspaces.source.path)"
              RUN_DIR="$(params.run-dir)"
              echo "Per-run source root: $RUN_DIR (under $(workspaces.source.path))"
              if [ -e "$RUN_DIR" ]; then
                echo "Removing existing $RUN_DIR/ (stale from a same-name retry)"
                rm -rf "$RUN_DIR"
              fi
              mkdir -p "$RUN_DIR"
              echo "Clean source root ready."
      workspaces:
        - name: source
          workspace: shared-data

    # 2. Clone the consumer's spec repo into <spec-subdir>
    - name: sync-spec
      timeout: "10m"
      runAfter:
        - cleanup-workspace
      taskRef:
        name: dav-git-sync
      workspaces:
        - name: source
          workspace: shared-data
      params:
        - name: repo-url
          value: $(params.consumer-spec-repo-url)
        - name: repo-branch
          value: $(params.consumer-spec-repo-branch)
        - name: target-subdir
          value: $(context.pipelineRun.name)/$(params.spec-subdir)

    # 3. Clone each corpus source into <corpus-subdir>/<namespace>/
    #    (per ADR-007 / M11b: multi-source-aware). Falls back to
    #    legacy single-source clone when dav-source-corpus has no
    #    `sources` key. corpus-namespaces param filters which sources
    #    to include for this run (empty = all).
    #
    #    Runs in parallel with sync-spec; both are read-only clones.
    - name: sync-corpus
      timeout: "10m"
      runAfter:
        - cleanup-workspace
      taskRef:
        name: dav-git-sync-multi-corpus
      workspaces:
        - name: source
          workspace: shared-data
      params:
        - name: workspace-subdir
          value: $(context.pipelineRun.name)/$(params.corpus-subdir)
        - name: corpus-namespaces
          value: $(params.corpus-namespaces)
        - name: legacy-uc-subpath
          value: $(params.corpus-uc-subpath)

    # 4. Run DAV stage 2 across the corpus
    #    Per-UC wall time at LLM inference is highly variable depending on
    #    UC complexity, ensemble sample count, model size, and inference
    #    backend. Allow up to 24h for a full corpus run (~10-30 UCs at
    #    verification-mode N=3 against 32B+ models).
    - name: run-corpus
      timeout: "24h"
      runAfter:
        - sync-spec
        - sync-corpus
      taskRef:
        name: dav-run-corpus
      workspaces:
        - name: source
          workspace: shared-data
      params:
        # ADR-007/M11b: corpus-subdir is the PARENT dir; engine.gather_corpus
        # rglobs across all <namespace>/ subdirs (multi-source) OR the
        # legacy single-clone dir (single-source). corpus-uc-subpath is
        # honored only when the legacy clone path produced a flat repo
        # with UCs under a sub-path — we append it conditionally below.
        - name: corpus-subdir
          value: $(context.pipelineRun.name)/$(params.corpus-subdir)
        - name: spec-subdir
          value: $(context.pipelineRun.name)/$(params.spec-subdir)
        - name: output-subdir
          value: "results"
        - name: mode
          value: $(params.mode)
        - name: sample-count
          value: $(params.sample-count)
        - name: sample-concurrency
          value: $(params.sample-concurrency)
        - name: uc-concurrency
          value: $(params.uc-concurrency)
        - name: halt-on-error
          value: $(params.halt-on-error)
        - name: uc-handles
          value: $(params.uc-handles)
        - name: uc-uuids
          value: $(params.uc-uuids)
        - name: known-capability-ids
          value: $(params.known-capability-ids)
        - name: stage2-context
          value: $(params.stage2-context)
        - name: capability-catalog-b64
          value: $(params.capability-catalog-b64)
        - name: tag-untagged-gaps
          value: $(params.tag-untagged-gaps)
        - name: managed-uc-uuids
          value: $(params.managed-uc-uuids)
        - name: console-api-url
          value: $(params.console-api-url)
        - name: inference-endpoint
          value: $(params.inference-endpoint)
        - name: inference-model
          value: $(params.inference-model)
        - name: pass1-inference-endpoint
          value: $(params.pass1-inference-endpoint)
        - name: pass1-inference-model
          value: $(params.pass1-inference-model)
        - name: inference-topology
          value: $(params.inference-topology)
        - name: mcp-url
          value: $(params.mcp-url)
        - name: consumer-profile-path
          value: $(params.consumer-profile-path)
        - name: spec-namespaces
          value: $(params.spec-namespaces)
        - name: use-key
          value: $(params.use-key)
        - name: capabilities-json
          value: $(params.capabilities-json)
        - name: use-profile-json
          value: $(params.use-profile-json)
        - name: stage2-two-pass
          value: $(params.stage2-two-pass)
        - name: grounding-nudge
          value: $(params.grounding-nudge)
        - name: max-tokens
          value: $(params.max-tokens)
        - name: request-timeout-seconds
          value: $(params.request-timeout-seconds)

  # Per-run source isolation (task #52): spec/ and corpus/ are cloned under
  # <pipelineRun-name>/ so concurrent A/B arms never collide on the shared
  # dav-workspace PVC. This finally task removes THIS run's source tree once
  # run-corpus is done — regardless of success/failure — while results/
  # (keyed by run-id at the workspace top level) is deliberately left intact.
  finally:
    - name: gc-run-source
      params:
        - name: run-dir
          value: $(context.pipelineRun.name)
      taskSpec:
        params:
          - name: run-dir
            type: string
        workspaces:
          - name: source
        steps:
          - name: wipe-run-source
            image: registry.access.redhat.com/ubi9/ubi-minimal
            script: |
              #!/bin/sh
              set -e
              cd "$(workspaces.source.path)"
              RUN_DIR="$(params.run-dir)"
              if [ -n "$RUN_DIR" ] && [ -e "$RUN_DIR" ]; then
                echo "GC: removing per-run source tree $RUN_DIR/"
                rm -rf "$RUN_DIR"
              else
                echo "GC: nothing to remove for $RUN_DIR/"
              fi
      workspaces:
        - name: source
          workspace: shared-data
