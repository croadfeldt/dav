---
# DAV Corpus Sourcing ConfigMap
# ---
# Mirror of dav-source-spec post-ADR-007 (M11): supports either legacy
# single-source or multi-source mode. The corpus projector
# (review-console/api/app/projector.py.project_corpus_sources) regenerates
# the `sources` field from managed_repos rows with role=corpus on
# every CRUD touching that role.
#
# Two data shapes supported:
#
#   1. Multi-source (preferred): a `sources` field carrying a YAML list
#      of sources. Each: {namespace, repo_url, repo_branch, root_path}.
#      The Tekton pipeline clones each (optionally filtered by a
#      per-run namespace selector) into /workspace/corpus/<namespace>/.
#
#   2. Legacy single-source: `repo_url` and `repo_branch` at top-level data.
#      Pre-projection / fresh deploys. Auto-converted by the projector
#      on the first role=corpus CRUD.
#
# Unlike the spec side, corpus changes do NOT trigger a Deployment rollout.
# Each Tekton PipelineRun re-reads the ConfigMap at start, so the next
# run picks up new content automatically.
apiVersion: v1
kind: ConfigMap
metadata:
  name: dav-source-corpus
  namespace: {{ dav_namespace }}
  labels:
    app: dav
    component: sourcing
    dav.dev/source-type: "corpus"
  annotations:
    dav.dev/managed-by: "ansible"
    dav.dev/last-applied-by: "ansible"
    dav.dev/last-applied-at: "{{ ansible_date_time.iso8601 }}"
{% if consumer_corpus_sources is defined and consumer_corpus_sources | length > 0 %}
    dav.dev/ansible-managed-initial-source-count: "{{ consumer_corpus_sources | length }}"
data:
  # Multi-source mode. List of {namespace, repo_url, repo_branch, root_path}.
  sources: |
{% for src in consumer_corpus_sources %}
    - namespace: "{{ src.namespace }}"
      repo_url: "{{ src.repo_url }}"
      repo_branch: "{{ src.repo_branch }}"
      root_path: "{{ src.root_path | default('') }}"
{% endfor %}
{% else %}
    dav.dev/ansible-managed-initial-url: "{{ consumer_corpus_repo_url }}"
    dav.dev/ansible-managed-initial-branch: "{{ consumer_corpus_repo_branch }}"
data:
  # Legacy single-source mode. Maintained for backward compatibility.
  repo_url: "{{ consumer_corpus_repo_url }}"
  repo_branch: "{{ consumer_corpus_repo_branch }}"
{% endif %}
