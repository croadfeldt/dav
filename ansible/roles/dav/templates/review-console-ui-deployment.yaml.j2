---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dav-review-ui
  namespace: {{ dav_namespace }}
  labels:
    app: dav-review
    component: review-console-ui
  annotations:
    image.openshift.io/triggers: |-
      [{"from":{"kind":"ImageStreamTag","name":"dav-review-ui:latest"},
        "fieldPath":"spec.template.spec.containers[?(@.name==\"nginx\")].image"}]
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: dav-review
      component: review-console-ui
  template:
    metadata:
      labels:
        app: dav-review
        component: review-console-ui
    spec:
      serviceAccountName: dav-review-ui
      containers:
        - name: nginx
          image: "{{ review_console_image_ui }}"
          ports:
            - containerPort: 8080
              name: http
{% if review_console_loadbalancer_enabled | default(false) %}
            - containerPort: {{ review_console_loadbalancer_tls_port }}
              name: https-lb
{% endif %}
          volumeMounts:
            - name: nginx-config
              mountPath: /opt/app-root/etc/nginx.default.d
              readOnly: true
{% if review_console_loadbalancer_enabled | default(false) %}
            - name: nginx-tls-config
              mountPath: /opt/app-root/etc/nginx.d
              readOnly: true
            - name: public-tls
              mountPath: /etc/nginx/tls
              readOnly: true
{% endif %}
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 2
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 15
          resources:
            requests:
              cpu: "10m"
              memory: "32Mi"
            limits:
              cpu: "200m"
              memory: "128Mi"
{% if review_console_enable_oauth %}
        - name: oauth-proxy
          image: {{ review_console_oauth_proxy_image }}
          args:
            - --provider=openshift
            - --https-address=:8443
            - --http-address=
            - --openshift-service-account=dav-review-ui
            - --upstream=http://localhost:8080
            # M12 — LLM-bound endpoints (bulk extract, wizard generate / refine)
            # can take minutes on local models. Default oauth-proxy upstream
            # timeout is 30s — too tight, surfaces as 502 with the only signal
            # being "timeout awaiting response headers" in proxy logs. Match
            # the route + nginx 600s ceiling.
            - --upstream-timeout=600s
            - --tls-cert=/etc/tls/private/tls.crt
            - --tls-key=/etc/tls/private/tls.key
            - --cookie-secret-file=/etc/proxy/secrets/session-secret
            - --pass-user-headers=true
            - --pass-access-token=false
            - --set-xauthrequest=true
            - --skip-auth-regex=^/healthz$
            # Webhook endpoints validate their own auth (HMAC-SHA256
            # against per-repo secrets per ADR-004). OAuth would block
            # GitHub. /api/webhooks/* is the namespace for all webhook
            # receivers (currently: github/pr-comments; future: more).
            - --skip-auth-regex=^/api/webhooks/
{% if review_console_relaxed_proxy | default(false) %}
            # Relaxed-proxy mode (internal / invited users). The SPA + the whole
            # API are reachable WITHOUT an OCP login so internal users can sign
            # in (app-native session) and accept invites; the API then authorizes
            # EVERYONE itself — you MUST set DAV_REQUIRE_AUTH=true on the API or
            # /api/* is open. The dedicated `/sso` path is deliberately NOT
            # skipped: it stays OCP-protected so it receives X-Forwarded headers
            # and mints an app session (nginx routes /sso -> /api/auth/sso).
            - --skip-auth-regex=^/$
            - --skip-auth-regex=^/index\.html$
            - --skip-auth-regex=^/assets/
            - --skip-auth-regex=^/favicon
            - --skip-auth-regex=^/api/
{% endif %}
          ports:
            - containerPort: 8443
              name: https
          volumeMounts:
            - name: proxy-tls
              mountPath: /etc/tls/private
              readOnly: true
            - name: proxy-secrets
              mountPath: /etc/proxy/secrets
              readOnly: true
          readinessProbe:
            httpGet:
              path: /oauth/healthz
              port: 8443
              scheme: HTTPS
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests: { cpu: "10m", memory: "32Mi" }
            limits:   { cpu: "100m", memory: "128Mi" }
{% endif %}
      volumes:
        - name: nginx-config
          configMap:
            name: dav-review-ui-nginx
{% if review_console_loadbalancer_enabled | default(false) %}
        - name: nginx-tls-config
          configMap:
            name: dav-review-ui-nginx-tls
        - name: public-tls
          secret:
            secretName: {{ review_console_loadbalancer_tls_secret }}
{% endif %}
{% if review_console_enable_oauth %}
        - name: proxy-tls
          secret:
            secretName: dav-review-ui-tls
        - name: proxy-secrets
          secret:
            secretName: dav-review-ui-session
{% endif %}
