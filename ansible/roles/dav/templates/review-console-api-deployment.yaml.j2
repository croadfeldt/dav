---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dav-review-api
  namespace: {{ dav_namespace }}
  labels:
    app: dav-review
    component: review-console-api
  annotations:
    image.openshift.io/triggers: |-
      [{"from":{"kind":"ImageStreamTag","name":"dav-review-api:latest"},
        "fieldPath":"spec.template.spec.containers[?(@.name==\"api\")].image"}]
    # --- Sourcing metadata (readable by oc describe and by the web UI) ---
    # Mirrors the authoritative state in dav-source-corpus ConfigMap.
    dav.dev/source-type: "corpus"
    dav.dev/source-repo-url: "{{ consumer_corpus_repo_url }}"
    dav.dev/source-repo-branch: "{{ consumer_corpus_repo_branch }}"
    dav.dev/source-configmap: "dav-source-corpus"
    dav.dev/last-applied-at: "{{ ansible_date_time.iso8601 }}"
spec:
  replicas: 1
  # Recreate (not RollingUpdate): the API mounts RWX CephFS volumes (dav-workspace,
  # dav-uc-repos). A rolling update briefly runs two pods that both mount the same
  # CephFS volumes, which on this external-ODF cluster intermittently hangs the
  # CSI MountDevice (DeadlineExceeded → stuck "operation already exists" op-lock),
  # deadlocking the rollout. Recreate tears down the old pod before starting the
  # new one, so only one pod ever mounts. (2026-06-29)
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: dav-review
      component: review-console-api
  template:
    metadata:
      labels:
        app: dav-review
        component: review-console-api
    spec:
      serviceAccountName: dav-review-api
      affinity:
        podAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchLabels:
                    app: dav-review
                    component: review-console-db
                topologyKey: kubernetes.io/hostname
      initContainers:
        # ADR-007 / M11: dav-source-corpus is now a multi-source ConfigMap with
        # a `sources` YAML list; the legacy top-level repo_url/repo_branch keys
        # are optional and present only in fresh / pre-projection installs.
        # The Tekton stage-2 pipeline does the real multi-source clone at run
        # start (dav-git-sync-multi-corpus task). This init container is a
        # legacy pre-seed for the API's directory-mode corpus loader; it's a
        # no-op when the ConfigMap is multi-source. The API's startup seed
        # already tolerates an empty /data/repo (main.py:207 warns + skips).
        - name: git-clone-corpus
          image: alpine/git:latest
          env:
            - name: REPO_URL
              valueFrom:
                configMapKeyRef:
                  name: dav-source-corpus
                  key: repo_url
                  optional: true
            - name: REPO_BRANCH
              valueFrom:
                configMapKeyRef:
                  name: dav-source-corpus
                  key: repo_branch
                  optional: true
          command:
            - /bin/sh
            - -c
            - |
              if [ -n "${REPO_URL:-}" ] && [ -n "${REPO_BRANCH:-}" ]; then
                git clone --depth 1 --branch "$REPO_BRANCH" "$REPO_URL" /data/repo && \
                echo "Corpus clone from $REPO_URL#$REPO_BRANCH: $(find /data/repo -type f | wc -l) files"
              else
                echo "Multi-source corpus mode — Tekton handles corpus clone at run start; skipping legacy pre-seed"
                mkdir -p /data/repo
              fi
          volumeMounts:
            - name: corpus
              mountPath: /data
      containers:
        - name: api
          image: "{{ review_console_image_api }}"
          ports:
            - containerPort: 8000
              name: http
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: dav-review-db-creds
                  key: dsn
            - name: LOG_LEVEL
              value: "INFO"
            - name: CORPUS_MODE
              value: "directory"
            - name: CORPUS_DIR
              value: "/data/repo"
            - name: CORPUS_INCLUDE
              value: "{{ review_console_corpus_include }}"
            - name: CORPUS_EXCLUDE
              value: "{{ review_console_corpus_exclude }}"
            - name: DAV_TRIGGER_ENABLED
              value: "{{ 'true' if (review_console_runs_trigger_enabled | default(true)) else 'false' }}"
            - name: DAV_NAMESPACE
              value: "{{ dav_namespace }}"
            - name: DAV_PIPELINE_NAME
              value: "{{ review_console_runs_pipeline_name }}"
            - name: DAV_PIPELINE_WORKSPACE
              value: "{{ review_console_runs_pipeline_workspace | default('shared-data') }}"
            - name: DAV_PIPELINE_WORKSPACE_PVC
              value: "{{ dav_workspace_pvc_name }}"
            - name: DAV_DEFAULT_BRANCH
              value: "{{ consumer_spec_repo_branch }}"
            - name: DAV_WORKSPACE_PATH
              value: "/workspace"
            - name: DAV_METRICS_CA_PATH
              value: "/var/run/configmaps/service-ca/service-ca.crt"
            # Fernet key for per-repo credential encryption (ADR-004).
            # Sourced from the Ansible-managed dav-fernet-key Secret.
            # Without it, the API starts but per-repo PAT / webhook
            # secret endpoints return 503. Generate once with:
            #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
            # then put in vars.local.yaml as vault_dav_fernet_key + redeploy.
            - name: DAV_FERNET_KEY
              valueFrom:
                secretKeyRef:
                  name: dav-fernet-key
                  key: key
                  optional: true
            # Engine→API service auth: the engine presents its ServiceAccount
            # projected token (audience below) as a Bearer token; this API
            # validates it via TokenReview (needs the system:auth-delegator
            # ClusterRole on the dav-review-api SA) and authorizes it as
            # system:engine. No shared static secret. DAV_API_AUDIENCE must
            # match the audience the Tekton task mints the projected token with.
            - name: DAV_API_AUDIENCE
              value: "{{ dav_api_token_audience | default('dav-api') }}"
            - name: DAV_TRUSTED_SERVICE_ACCOUNTS
              value: "system:serviceaccount:{{ dav_namespace }}:{{ dav_pipeline_service_account | default('pipeline') }}"
            # Multi-user auth enforcement. When true the API enforces app
            # sessions, the approval gate, and role scoping (single-user
            # passthrough otherwise). Pair with review_console_relaxed_proxy
            # so the oauth-proxy lets the app's own login + /api/auth/* through.
            - name: DAV_REQUIRE_AUTH
              value: "{{ 'true' if (review_console_require_auth | default(false)) else 'false' }}"
            # Break-glass internal platform-admin seeded on first boot (forced
            # password change on first login). Password from the vault var when
            # set, else the API default ("changeme").
            - name: DAV_DEFAULT_ADMIN_EMAIL
              value: "{{ review_console_default_admin_email | default('admin@dav.local') }}"
            # Public base URL for outbound links (invites). Explicit override, else
            # derived from the hostname + a custom port. The port is appended ONLY
            # when the LoadBalancer is enabled AND the port is non-standard (not
            # 80/443) — otherwise no port is added.
{% set _bport = review_console_loadbalancer_port | default('') | string %}
{% set _buseport = (review_console_loadbalancer_enabled | default(false)) and _bport and _bport not in ['80', '443'] %}
            - name: DAV_PUBLIC_BASE_URL
              value: "{{ review_console_public_base_url if (review_console_public_base_url | default('')) else ('https://' + review_console_hostname + (':' ~ _bport if _buseport else '')) }}"
{% if vault_review_console_default_admin_password is defined and vault_review_console_default_admin_password | length > 0 %}
            # Break-glass admin bootstrap password — sourced from a Secret (never a
            # plaintext `value:` in the pod spec / rendered manifest).
            - name: DAV_DEFAULT_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: dav-review-admin-bootstrap
                  key: password
{% endif %}
{% if dav_docs_mcp_lb_enabled | default(false) %}
            # Secured dav-docs-mcp self-registration (LB URL + bearer token). The
            # API upserts the dav-docs-mcp MCP row with these on boot (_seed_docs_mcp).
            - name: DAV_DOCS_MCP_URL
              value: "https://{{ dav_docs_mcp_hostname | default('dav-docs-mcp.roadfeldt.com') }}/sse"
            - name: DAV_DOCS_MCP_TOKEN
              valueFrom:
                secretKeyRef:
                  name: dav-docs-mcp-token
                  key: token
{% endif %}
          # Optional Secret for tokens the API needs at runtime — currently:
          #   DAV_CORPUS_PUSH_TOKEN   GitHub PAT (repo scope) used by Push-to-corpus
          #   DAV_UC_ASSIST_API_KEY   fallback for UC Assist when no DB-backed
          #                           model_config has use_uc_assist=true
          #
          # Note: GitHub PATs for the PR-comment poller (M5) are now
          # per-repo (ADR-004), stored Fernet-encrypted in
          # managed_repos.github_pat_encrypted. Set them via the Repos
          # UI, not via this Secret. Likewise per-repo webhook secrets
          # for the M6 receiver (managed_repos.github_webhook_secret_encrypted).
          #
          # Create / update with:
          #   oc create secret generic dav-review-api-tokens \
          #     --from-literal=DAV_CORPUS_PUSH_TOKEN=ghp_... \
          #     -n {{ dav_namespace }}
          # then `oc rollout restart deploy/dav-review-api -n {{ dav_namespace }}`.
          envFrom:
            - secretRef:
                name: dav-review-api-tokens
                optional: true
            # Optional LDAP config for multi-user approval + roles. When absent,
            # the access gate is disabled (single-user behavior). Keys:
            #   DAV_LDAP_URL DAV_LDAP_BIND_DN DAV_LDAP_BIND_PASSWORD
            #   DAV_LDAP_USER_BASE DAV_LDAP_GROUP_DN DAV_LDAP_USER_ATTR
            #   DAV_LDAP_MAIL_ATTR DAV_LDAP_NAME_ATTR DAV_LDAP_MEMBER_ATTR
            #   DAV_LDAP_START_TLS DAV_LDAP_ENFORCE DAV_LDAP_BOOTSTRAP_ADMINS
            # See review-console/deploy/dav-ldap-secret.example.yaml.
            - secretRef:
                name: dav-ldap
                optional: true
          volumeMounts:
            - name: corpus
              mountPath: /data
              readOnly: true
            - name: workspace
              mountPath: /workspace
              readOnly: true
            - name: service-ca
              mountPath: /var/run/configmaps/service-ca
              readOnly: true
{% if review_console_uc_repos_enabled | default(true) %}
            # DAV-hosted ('pvc-local') UC git stores — bare repos written here.
            # RW, unlike the read-only corpus/workspace mounts above.
            - name: uc-repos
              mountPath: /uc-repos
{% endif %}
          readinessProbe:
            httpGet:
              path: /readyz
              port: 8000
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8000
            initialDelaySeconds: 30
            periodSeconds: 15
          resources:
            requests:
              cpu: "50m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
      volumes:
        - name: corpus
          emptyDir: {}
        - name: workspace
          persistentVolumeClaim:
            claimName: "{{ dav_workspace_pvc_name }}"
            readOnly: true
        - name: service-ca
          configMap:
            name: dav-review-service-ca
            optional: true   # tolerate first deploy where service-ca CM hasn't reconciled yet
{% if review_console_uc_repos_enabled | default(true) %}
        - name: uc-repos
          persistentVolumeClaim:
            claimName: dav-uc-repos
{% endif %}
