---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: dav-review-ui
  namespace: {{ dav_namespace }}
  labels:
    app: dav-review
    component: review-console-ui
  annotations:
    # LLM-backed endpoints (/api/uc-assist, /api/use-cases/bulk-from-text)
    # routinely exceed the 30s default haproxy server timeout when the model
    # is generating long YAML or extracting many UCs from a transcript. The
    # uc_assist client uses a 300s timeout; bulk extract uses 600s. Match
    # the slower one here so the router doesn't 504 before the API replies.
    haproxy.router.openshift.io/timeout: "600s"
{% if review_console_cert_manager_enabled | default(false) %}
    # cert-manager openshift-routes controller: provision a Let's Encrypt cert
    # onto spec.tls.{certificate,key}. Ansible (field_manager: ansible) never
    # sets those fields, so server-side apply lets the controller co-own them —
    # re-running the playbook does not clobber the issued cert.
    cert-manager.io/issuer-name: "{{ review_console_cert_manager_issuer_name }}"
    cert-manager.io/issuer-kind: "{{ review_console_cert_manager_issuer_kind }}"
    cert-manager.io/issuer-group: "{{ review_console_cert_manager_issuer_group }}"
{% if review_console_cert_manager_duration | default('') | length > 0 %}
    cert-manager.io/duration: "{{ review_console_cert_manager_duration }}"
{% endif %}
{% if review_console_cert_manager_renew_before | default('') | length > 0 %}
    cert-manager.io/renew-before: "{{ review_console_cert_manager_renew_before }}"
{% endif %}
{% endif %}
spec:
  host: {{ review_console_hostname }}
  to:
    kind: Service
    name: dav-review-ui
    weight: 100
{% if review_console_enable_oauth %}
  port:
    targetPort: https
  tls:
    termination: reencrypt
    insecureEdgeTerminationPolicy: Redirect
{% else %}
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
{% endif %}
  wildcardPolicy: None
