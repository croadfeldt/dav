---
# MetalLB LoadBalancer for hosting the console on a dedicated IP + custom port,
# bypassing the OCP router. Internal DNS for {{ review_console_hostname }} points
# here, and the firewall forwards the WAN port to the same IP:port — so both
# paths share port {{ review_console_loadbalancer_port }}. Targets nginx's TLS
# listener ({{ review_console_loadbalancer_tls_port }}); oauth-proxy is NOT in
# this path.
apiVersion: v1
kind: Service
metadata:
  name: dav-review-ui-lb
  namespace: {{ dav_namespace }}
  labels:
    app: dav-review
    component: review-console-ui
  annotations:
{% if review_console_loadbalancer_ip | default('') | length > 0 %}
    metallb.universe.tf/loadBalancerIPs: "{{ review_console_loadbalancer_ip }}"
{% endif %}
{% if review_console_loadbalancer_pool | default('') | length > 0 %}
    metallb.universe.tf/address-pool: "{{ review_console_loadbalancer_pool }}"
{% endif %}
spec:
  type: LoadBalancer
  # externalTrafficPolicy: the server-vlan MetalLB pool is advertised via BGP (not L2), so
  # `Local` blackholes the VIP whenever the pod migrates to a node MetalLB isn't advertising
  # from — the advertisement does not follow the pod (observed 2026-07-11). `Cluster` advertises
  # from all nodes and routes to the pod wherever it runs, resilient to migration. Source IP is
  # SNAT'd at the node, but the real client is still visible via X-Forwarded-For at the nginx TLS
  # layer. Override per-environment (e.g. `Local` for an L2 pool) with review_console_loadbalancer_etp.
  externalTrafficPolicy: {{ review_console_loadbalancer_etp | default('Cluster') }}
  selector:
    app: dav-review
    component: review-console-ui
  ports:
    - name: https
      port: {{ review_console_loadbalancer_port }}
      targetPort: {{ review_console_loadbalancer_tls_port }}
      protocol: TCP
