---
# Tekton Task: run DAV stage 2 across a UC corpus.
#
# This task wraps `python -m dav.stages.run_corpus`, which iterates the
# consumer's UC corpus in a single container, writes per-UC analyses,
# and produces a unified run-summary.yaml.
#
# Engine-side iteration: one container, one Python process,
# loops the corpus internally. Per-UC failure isolation is handled by
# the runner; the task either succeeds (all UCs ran) or fails (something
# at the runner level broke; per-UC failures are reported in the run
# summary, not as task failures, unless --halt-on-error is set).
#
# Workspace layout expected:
#   $(params.corpus-subdir)/   ← consumer corpus (UCs + dav-version.yaml)
#   $(params.spec-subdir)/     ← consumer spec content (architecture docs)
#   $(params.output-subdir)/   ← run outputs go here as <run-id>/
#
# Both subdirectories are populated by upstream git-sync tasks before
# this task runs; see pipeline-stage2.yaml.j2.

apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: dav-run-corpus
  namespace: {{ dav_namespace }}
  labels:
    app.kubernetes.io/part-of: dav
spec:
  description: |
    Run DAV stage 2 analysis across an entire UC corpus.

  params:
    - name: corpus-subdir
      type: string
      description: |
        Path to the UC corpus, relative to the workspace root.
        Default matches the corpus subdirectory created by the
        upstream consumer-corpus-sync task in pipeline-stage2.
      default: "corpus/use-cases"

    - name: spec-subdir
      type: string
      description: |
        Path to the consumer's spec content (used as
        --consumer-content-path so the analyzer can read
        consumer_version from dav-version.yaml).
      default: "spec"

    - name: output-subdir
      type: string
      description: |
        Path under the workspace where run results land. The runner
        creates a <run-id> subdirectory inside this.
      default: "results"

    - name: mode
      type: string
      description: "verification | reproduce | explore"
      default: "verification"

    - name: sample-count
      type: string
      description: |
        Override the mode's default sample count. Empty string = use
        mode default (3 / 1 / 10 for verification / reproduce / explore).
      default: ""

    - name: seed
      type: string
      description: |
        Override the seed (verification: base seed; reproduce: the seed).
        Empty string = derive from UC uuid.
      default: ""

    - name: halt-on-error
      type: string
      description: "true | false — stop the run on first UC failure"
      default: "false"

    - name: inference-endpoint
      type: string
      description: OpenAI-compatible inference base URL
      default: "{{ inference_primary_endpoint }}"

    - name: inference-model
      type: string
      description: Model name served at the endpoint
      default: "{{ inference_primary_model }}"

    - name: inference-topology
      type: string
      description: |
        Operator-supplied label describing the inference topology
        (e.g. 'dual-r9700-tp2-q8' or 'single-l4-fp16'). Stamped onto
        AnalysisMetadata.inference_topology for run provenance.
        Empty string is acceptable.
      default: "{{ inference_topology | default('') }}"

    - name: mcp-url
      type: string
      description: dav-docs-mcp base URL
      default: "http://dav-docs-mcp.{{ dav_namespace }}.svc:8080"

    - name: consumer-profile-path
      type: string
      description: |
        Path to a consumer profile YAML (relative to workspace).
        Empty = use built-in DCM reference profile.
      default: ""

    - name: spec-namespaces
      type: string
      description: |
        Comma-separated list of role=spec namespaces the engine should
        focus the LLM on for this run. Empty = no narrowing. Exposed to
        the engine via the DAV_SPEC_NAMESPACES_FILTER env var; engine
        injects this as a focus hint into the LLM system prompt. Soft
        enforcement — the MCP itself still holds every spec namespace.
      default: ""

    # Per-(model, use) override system (DAV migration 014). API resolves
    # the model's capabilities row + the matching use_profile from DB
    # before triggering the PipelineRun and threads them here as JSON.
    - name: use-key
      type: string
      description: |
        model_use_profiles use_key for this run (one of:
        evaluation_verification, evaluation_explore,
        evaluation_reproduce, arch_review, uc_assist, enhancement).
        Recorded in run-summary.yaml.effective_sampling.use_key for
        provenance. Empty = unspecified (engine treats as no profile).
      default: ""
    - name: capabilities-json
      type: string
      description: |
        JSON object of model_configs.capabilities for the inference
        model. Engine drops disallowed params at body-build time per
        EndpointConfig.capabilities. Empty / "{}" = no filtering.
      default: ""
    - name: use-profile-json
      type: string
      description: |
        JSON object of model_use_profiles.params for (this model × this
        use_key). Layer between mode defaults and explicit CLI overrides.
        Empty / "{}" = mode defaults apply.
      default: ""

    - name: stage2-two-pass
      type: string
      description: |
        Forces stage-2 two-pass mode on/off via the DAV_STAGE2_TWO_PASS
        env var. "1" (default) runs the two-pass explore → findings →
        synthesize flow added 2026-05-28; "0" runs the legacy
        single-pass body. Surfaced as a per-run override so operators
        can A/B without an engine rebuild — added 2026-05-29 for the
        Qwen3.6-27B MTP investigation.
      default: "1"

    - name: grounding-nudge
      type: string
      description: |
        #45b grounding nudge. "1"/"true" injects (via DAV_GROUNDING_NUDGE) a
        terse, OFF-by-default behavioral push toward spec-anchored claims —
        the lever the 2026-05-30 72B eval isolated. Per-run override so it can
        be A/B-validated against exploration_delta + the shallow signal before
        it is ever made the default. "0" (default) = no nudge, production prompt.
      default: "0"


    - name: max-tool-calls
      type: string
      default: "30"

    - name: max-tokens
      type: string
      # Per-turn LLM output budget. Now a deployment variable
      # (dav_stage2_max_tokens) because the safe ceiling is
      # throughput-dependent — see group_vars/all/vars.yaml for the
      # full rationale.
      #
      # History: iterated 6144 → 8192 → 16384 on 2026-05-28 because
      # UC #6 (infrastructure/prod/greenfield) emits a ~9000-token,
      # 33,907-char analysis that 8192 chopped mid-component. But on
      # the slow AMD stack 16384 let degenerate over-generations run
      # past the 600s route timeout → 504 (OSAC 2026-05-29/30, runs
      # 092466/098818). The budget must satisfy
      # max_tokens/throughput < route_timeout; the default below
      # (10240) covers UC #6 with margin while staying under 600s at
      # this stack's ~20 tok/s.
      default: "{{ dav_stage2_max_tokens }}"

    - name: cache-prompt
      type: string
      description: "true | false — enable llama.cpp KV cache reuse"
      default: "false"

    - name: log-level
      type: string
      default: "INFO"

    - name: uc-handles
      type: string
      description: |
        Optional comma-separated list of UC `handle:` values. When set,
        the engine processes ONLY those UCs from the corpus subpath,
        skipping siblings. Used by the console for Set runs and
        single-UC test evaluations. Empty = run everything (existing
        directory-scoped behavior).
      default: ""

    - name: uc-uuids
      type: string
      description: |
        Optional comma-separated list of UC `uuid:` values. Same as
        uc-handles but matches on UUID. Combined with uc-handles via OR.
      default: ""

    - name: managed-uc-uuids
      type: string
      description: |
        Comma-separated managed-UC UUIDs to fetch from the console API
        and include alongside corpus UCs. Used by the console's Test
        evaluation for unpushed managed UCs — the engine materializes
        them into a temp dir at run start and processes them like any
        corpus UC. Requires console-api-url.
      default: ""

    - name: console-api-url
      type: string
      description: |
        Base URL of the DAV review console API used to fetch managed
        UCs. In-cluster default points at the API Service. Only used
        when managed-uc-uuids is non-empty.
      default: "http://dav-review-api.{{ dav_namespace }}.svc.cluster.local:8000"

  workspaces:
    - name: source
      description: |
        Shared workspace containing the consumer corpus, spec content,
        and the results directory.

  steps:
    - name: run-corpus
      image: "image-registry.openshift-image-registry.svc:5000/{{ dav_namespace }}/dav-engine:latest"
      workingDir: $(workspaces.source.path)
      env:
        - name: PYTHONUNBUFFERED
          value: "1"
        # M12 follow-up: per-run spec source filter. Engine reads this env
        # var (when set) and injects "focus on namespaces: X, Y" into the
        # LLM system prompt. Empty string = no narrowing.
        - name: DAV_SPEC_NAMESPACES_FILTER
          value: "$(params.spec-namespaces)"
        # Set DAV_STAGE2_TWO_PASS=0 to force single-pass stage-2 (legacy
        # behavior). Default "1" enables the two-pass exploration → findings
        # → synthesis flow added 2026-05-28. Surfaced here so operators
        # can A/B between the two without an engine rebuild. Set
        # explicitly to "0" via the Tekton param flag below; empty value
        # keeps the engine default of two-pass.
        - name: DAV_STAGE2_TWO_PASS
          value: "$(params.stage2-two-pass)"
        # #45b: OFF by default ("0"); a candidate run sets "1" to A/B the
        # grounding nudge without an engine rebuild.
        - name: DAV_GROUNDING_NUDGE
          value: "$(params.grounding-nudge)"
        # Where the engine reads its ServiceAccount projected token to
        # authenticate to the console API (Bearer) when fetching managed UCs.
        # The kubelet mints + auto-rotates this token (audience {{ dav_api_token_audience | default('dav-api') }},
        # ~1h TTL) into the projected volume below; the API validates it via
        # TokenReview. No shared static secret.
        - name: DAV_API_TOKEN_PATH
          value: /var/run/secrets/dav/api-token
      volumeMounts:
        - name: dav-api-token
          mountPath: /var/run/secrets/dav
          readOnly: true
      script: |
        #!/bin/sh
        set -e

        echo "=== DAV corpus run ==="
        echo "  Corpus:         $(params.corpus-subdir)"
        echo "  Spec content:   $(params.spec-subdir)"
        echo "  Output:         $(params.output-subdir)"
        echo "  Mode:           $(params.mode)"
        echo "  Inference:      $(params.inference-endpoint)"
        echo "  Model:          $(params.inference-model)"
        echo "  MCP:            $(params.mcp-url)"
        echo ""

        mkdir -p "$(params.output-subdir)"

        # Build optional args
        OPTIONAL_ARGS=""
        if [ -n "$(params.sample-count)" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --sample-count $(params.sample-count)"
        fi
        if [ -n "$(params.seed)" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --seed $(params.seed)"
        fi
        if [ "$(params.halt-on-error)" = "true" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --halt-on-error"
        fi
        if [ "$(params.cache-prompt)" = "true" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --cache-prompt"
        fi
        if [ -n "$(params.consumer-profile-path)" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --consumer-profile $(params.consumer-profile-path)"
        fi
        if [ -n "$(params.uc-handles)" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --uc-handles $(params.uc-handles)"
        fi
        if [ -n "$(params.uc-uuids)" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --uc-uuids $(params.uc-uuids)"
        fi
        if [ -n "$(params.managed-uc-uuids)" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --managed-uc-uuids $(params.managed-uc-uuids) --console-api-url $(params.console-api-url)"
        fi

        # Note: --no-enable-thinking is the recommended default for
        # Qwen3 stage 2 runs (see prompts.py rationale). We hardcode
        # it on; if a non-Qwen3 endpoint is used, the flag is harmless.
        # Per-(model, use) override args. Only forwarded when set so the
        # engine's "missing flag = use defaults" branch fires correctly.
        #
        # capabilities-json / use-profile-json contain JSON with spaces,
        # which gets argv-split by the shell when interpolated unquoted
        # into OPTIONAL_ARGS. Write to tmpfiles and pass `@/path` syntax
        # (engine.stages.run_corpus._parse_engine_json reads the file).
        # Single-quoting the param expansion in echo is safe for our
        # JSON shapes (keys/values are bool/int/string-without-quotes);
        # if we ever embed strings with apostrophes here, switch to a
        # heredoc or base64.
        if [ -n "$(params.use-key)" ]; then
          OPTIONAL_ARGS="$OPTIONAL_ARGS --use-key $(params.use-key)"
        fi
        if [ -n "$(params.capabilities-json)" ] && [ "$(params.capabilities-json)" != "{}" ]; then
          printf '%s\n' '$(params.capabilities-json)' > /tmp/dav-capabilities.json
          OPTIONAL_ARGS="$OPTIONAL_ARGS --capabilities-json @/tmp/dav-capabilities.json"
        fi
        if [ -n "$(params.use-profile-json)" ] && [ "$(params.use-profile-json)" != "{}" ]; then
          printf '%s\n' '$(params.use-profile-json)' > /tmp/dav-use-profile.json
          OPTIONAL_ARGS="$OPTIONAL_ARGS --use-profile-json @/tmp/dav-use-profile.json"
        fi

        python -m dav.stages.run_corpus \
          --corpus-path "$(params.corpus-subdir)" \
          --output-dir "$(params.output-subdir)" \
          --consumer-content-path "$(params.spec-subdir)" \
          --inference-endpoint "$(params.inference-endpoint)" \
          --inference-model "$(params.inference-model)" \
          --inference-topology "$(params.inference-topology)" \
          --mcp-url "$(params.mcp-url)" \
          --mode "$(params.mode)" \
          --max-tool-calls "$(params.max-tool-calls)" \
          --max-tokens "$(params.max-tokens)" \
          --no-enable-thinking \
          --log-level "$(params.log-level)" \
          $OPTIONAL_ARGS
  # Projected ServiceAccount token the engine presents to the console API
  # (Bearer) when fetching managed UCs. The kubelet mints it for the pod's SA
  # ({{ dav_namespace }}:pipeline), scoped to audience "{{ dav_api_token_audience | default('dav-api') }}" with a short TTL,
  # and auto-rotates the file in place. The API validates it via TokenReview —
  # short-lived + identity-bound, nothing static to leak.
  volumes:
    - name: dav-api-token
      projected:
        sources:
          - serviceAccountToken:
              path: api-token
              audience: {{ dav_api_token_audience | default('dav-api') }}
              expirationSeconds: 3600
