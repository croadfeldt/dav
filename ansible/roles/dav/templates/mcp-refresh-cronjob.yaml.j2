{# Auto-generated MCP-corpus refresh CronJob.
   Restarts the dav-docs-mcp deployment on a schedule so the
   git-clone init container re-pulls the spec/corpus repos and the
   MCP serves current content. Operators trigger the same restart
   manually via the "Refresh Now" button on the DAV Config page
   (POST /api/mcp/refresh-now in the review-console API).
   Schedule + enable flag come from role defaults / inventory vars:
     dav_docs_mcp_refresh_enabled
     dav_docs_mcp_refresh_schedule
     dav_docs_mcp_refresh_deployment
     dav_docs_mcp_refresh_service_account
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ dav_docs_mcp_refresh_service_account }}
  namespace: {{ dav_namespace }}
  labels:
    app.kubernetes.io/part-of: dav
    app.kubernetes.io/component: mcp-refresh
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ dav_docs_mcp_refresh_service_account }}
  namespace: {{ dav_namespace }}
  labels:
    app.kubernetes.io/part-of: dav
    app.kubernetes.io/component: mcp-refresh
rules:
  # Just enough to roll the deployment, nothing more.
  - apiGroups: ["apps"]
    resources: ["deployments"]
    resourceNames: ["{{ dav_docs_mcp_refresh_deployment }}"]
    verbs: ["get", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ dav_docs_mcp_refresh_service_account }}
  namespace: {{ dav_namespace }}
  labels:
    app.kubernetes.io/part-of: dav
    app.kubernetes.io/component: mcp-refresh
subjects:
  - kind: ServiceAccount
    name: {{ dav_docs_mcp_refresh_service_account }}
    namespace: {{ dav_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ dav_docs_mcp_refresh_service_account }}
{% if dav_docs_mcp_refresh_enabled | bool %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: dav-docs-mcp-refresh
  namespace: {{ dav_namespace }}
  labels:
    app.kubernetes.io/part-of: dav
    app.kubernetes.io/component: mcp-refresh
spec:
  schedule: "{{ dav_docs_mcp_refresh_schedule }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  startingDeadlineSeconds: 300
  jobTemplate:
    spec:
      backoffLimit: 1
      ttlSecondsAfterFinished: 1800
      template:
        metadata:
          labels:
            app.kubernetes.io/part-of: dav
            app.kubernetes.io/component: mcp-refresh
        spec:
          restartPolicy: OnFailure
          serviceAccountName: {{ dav_docs_mcp_refresh_service_account }}
          containers:
            - name: rollout-restart
              image: registry.redhat.io/openshift4/ose-cli:latest
              command:
                - /bin/sh
                - -c
                - |
                  # Patch the deployment with an updated restart annotation;
                  # this is what `oc rollout restart` does under the hood and
                  # requires only `apps/deployments` patch — no
                  # subresources/rollouts/* permissions needed.
                  set -e
                  oc -n {{ dav_namespace }} patch deployment/{{ dav_docs_mcp_refresh_deployment }} \
                    -p "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"dav.io/restartedAt\":\"$(date -u +%FT%TZ)\",\"dav.io/restartReason\":\"scheduled-mcp-refresh\"}}}}}"
              resources:
                requests:
                  cpu: 10m
                  memory: 32Mi
                limits:
                  cpu: 100m
                  memory: 64Mi
{% endif %}
