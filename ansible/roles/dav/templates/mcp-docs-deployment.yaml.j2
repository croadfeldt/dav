---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dav-docs-mcp
  namespace: {{ dav_namespace }}
  labels:
    app: dav-docs-mcp
    component: mcp-server
  annotations:
    # Auto-rollout when the dav-docs-mcp:latest ImageStreamTag is updated.
    # OpenShift patches spec.template.spec.containers[name=mcp-server].image
    # with the resolved SHA, triggering a fresh rollout.
    image.openshift.io/triggers: |
      [{"from":{"kind":"ImageStreamTag","name":"dav-docs-mcp:latest","namespace":"{{ dav_namespace }}"},"fieldPath":"spec.template.spec.containers[?(@.name==\"mcp-server\")].image"}]
    # --- Sourcing metadata (readable by oc describe and by the review-console web UI) ---
    # Mirror of the authoritative dav-source-spec ConfigMap state. Ansible
    # stamps initial values from consumer_spec_* vars; the review-console
    # API keeps them in sync when the UI switches sources.
    dav.dev/source-type: "spec"
{% if consumer_spec_sources is defined and consumer_spec_sources | length > 0 %}
    dav.dev/source-mode: "multi"
    dav.dev/source-count: "{{ consumer_spec_sources | length }}"
{% else %}
    dav.dev/source-mode: "single"
    dav.dev/source-repo-url: "{{ consumer_spec_repo_url }}"
    dav.dev/source-repo-branch: "{{ consumer_spec_repo_branch }}"
{% endif %}
    dav.dev/source-configmap: "dav-source-spec"
    dav.dev/last-applied-at: "{{ ansible_date_time.iso8601 }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dav-docs-mcp
  template:
    metadata:
      labels:
        app: dav-docs-mcp
        component: mcp-server
    spec:
      initContainers:
        # Uses the MCP image so python3 + pyyaml + git are already installed
        # (no apk/apt at pod start, no extra image pull, no non-root perms
        # surprises that bit alpine/git's apk).
        - name: git-clone
          image: {{ mcp_docs_image }}
          env:
            # Legacy single-source fallback. With optional=true, these are
            # absent when the ConfigMap is in multi-source mode (no repo_url
            # or repo_branch keys), and the init script falls through to
            # parsing /config/sources instead.
            - name: REPO_URL
              valueFrom:
                configMapKeyRef:
                  name: dav-source-spec
                  key: repo_url
                  optional: true
            - name: REPO_BRANCH
              valueFrom:
                configMapKeyRef:
                  name: dav-source-spec
                  key: repo_branch
                  optional: true
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              rm -f /data/.source-flags

              if [ -f /config/sources ]; then
                echo "[init] /config/sources detected — multi-source mode"
                python3 <<'PYEOF'
              import yaml, subprocess, sys
              with open('/config/sources') as f:
                  sources = yaml.safe_load(f)
              if not sources:
                  print('ERROR: /config/sources is empty', file=sys.stderr)
                  sys.exit(1)
              flag_lines = []
              skipped = []
              for src in sources:
                  ns = src['namespace']
                  url = src['repo_url']
                  branch = src['repo_branch']
                  root = (src.get('root_path') or '').strip('/')
                  dst = f'/data/{ns}'
                  print(f'[init] cloning {url}#{branch} -> {dst}', flush=True)
                  r = subprocess.run(['git', 'clone', '--depth', '1', '--branch', branch, url, dst])
                  if r.returncode != 0:
                      # Resilience: one misconfigured source (e.g. a wrong branch)
                      # must NOT crash-loop the whole docs MCP and take down every
                      # other source. Skip it — it just won't be served — and keep
                      # going. Operators fix the source in Config -> Repos.
                      print(f'[init] WARNING: skipping {ns} ({url}#{branch}) — clone failed (exit {r.returncode})',
                            file=sys.stderr, flush=True)
                      skipped.append(ns)
                      continue
                  served = f'{dst}/{root}' if root else dst
                  flag_lines.append(f'{ns}:{served}')
              if not flag_lines:
                  print('ERROR: no sources cloned successfully — nothing to serve', file=sys.stderr)
                  sys.exit(1)
              with open('/data/.source-flags', 'w') as f:
                  f.write('\n'.join(flag_lines) + '\n')
              print(f'[init] wrote {len(flag_lines)} source flag(s); skipped {len(skipped)}: {skipped}', flush=True)
              PYEOF
              elif [ -n "${REPO_URL:-}" ] && [ -n "${REPO_BRANCH:-}" ]; then
                echo "[init] no /config/sources — legacy single-source mode"
                git clone --depth 1 --branch "$REPO_BRANCH" "$REPO_URL" /data/repo
                echo "[init] cloned single-source: $REPO_URL#$REPO_BRANCH"
                echo "[init] $(ls /data/repo/architecture/data-model/*.md 2>/dev/null | wc -l) .md files in legacy data-model path"
              else
                echo "[init] ERROR: no sources configured (no /config/sources, no REPO_URL/REPO_BRANCH)" >&2
                exit 1
              fi
          volumeMounts:
            - name: docs
              mountPath: /data
            - name: source-config
              mountPath: /config
      containers:
        - name: mcp-server
          image: {{ mcp_docs_image }}
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              ARGS="--transport sse --host 0.0.0.0 --port 8080"
              if [ -f /data/.source-flags ]; then
                # Multi-source: build --source flags from init container output
                while IFS= read -r line; do
                  [ -z "$line" ] && continue
                  ARGS="$ARGS --source $line"
                done < /data/.source-flags
                echo "Starting MCP in multi-source mode with: $ARGS"
              else
                # Legacy single-source
                ARGS="$ARGS --docs-path /data/repo/architecture/data-model"
                echo "Starting MCP in single-source mode with: $ARGS"
              fi
              exec python server.py $ARGS
          ports:
            - containerPort: 8080
              name: http
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
          readinessProbe:
            tcpSocket:
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 30
          volumeMounts:
            - name: docs
              mountPath: /data
              readOnly: true
      volumes:
        - name: docs
          emptyDir: {}
        - name: source-config
          configMap:
            name: dav-source-spec
            # Each ConfigMap data key becomes a file under /config/. In
            # multi-source mode that's /config/sources (containing the YAML
            # list). In legacy mode that's /config/repo_url and
            # /config/repo_branch (which the init script ignores in favor of
            # the env vars).
---
apiVersion: v1
kind: Service
metadata:
  name: dav-docs-mcp
  namespace: {{ dav_namespace }}
spec:
  selector:
    app: dav-docs-mcp
  ports:
    - port: 8080
      targetPort: 8080
      name: http
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: dav-docs-mcp
  namespace: {{ dav_namespace }}
spec:
  to:
    kind: Service
    name: dav-docs-mcp
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
